TELEGRAM_BOT_TOKEN=ваш_токен_от_BotFather

# Учётные данные Postgres (docker compose и локальный клиент на хосте).
# Для продакшена сгенерируйте свой пароль; файл .env в git не коммитьте.
POSTGRES_USER=goldapple
POSTGRES_PASSWORD=your_password
POSTGRES_DB=goldapple

# Если бот запускается на машине (не в compose), тот же пароль, что выше:
# DATABASE_URL=postgresql://goldapple:your_password@localhost:5432/goldapple
